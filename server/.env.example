# Copy to .env and fill in real values. .env is gitignored - never commit it.

# The Pi's LAN-facing interface IP. Mosquitto's listener binds here, not
# 0.0.0.0, so the broker is reachable by the ESP32 on the home network but
# never through the Cloudflare Tunnel (server/mosquitto/README.md).
MOSQUITTO_LAN_BIND_IP=192.0.2.10

# Distinct client credentials per .claude/skills/mqtt-contract/SKILL.md.
# Generated with mosquitto_passwd (server/mosquitto/README.md); these env
# vars are what gate-api authenticates to the broker with, not what's stored
# in the broker's password file.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_API_CLIENT_ID=gate-api
MQTT_API_USERNAME=gate-api
MQTT_API_PASSWORD=change-me

# Timeout for correlating a gate/cmd/trigger publish with its gate/cmd/ack.
GATE_TRIGGER_ACK_TIMEOUT_S=5
